# ==============================================================================
# FOOD AI SERVICE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development / production)
APP_ENV=production
PORT=8000

# ==============================================================================
# DETECTOR CONFIGURATION
# ==============================================================================
# Active ingredient detection model loaded at service startup:
# Options: yolo26 | rtdetr | rfdetr
INGREDIENT_MODEL=rtdetr

# Model weights paths (relative to food-ai-service or absolute)
YOLO26_MODEL_PATH=models_weights/yolo26_best.pt
RTDETR_MODEL_PATH=models_weights/rtdetr_best.pt
RFDETR_MODEL_PATH=models_weights/rfdetr_best.pth

# Detection thresholds
DETECTION_CONFIDENCE=0.25

# ==============================================================================
# RAG (RETRIEVAL-AUGMENTED GENERATION) CONFIGURATION
# ==============================================================================
# Path to the 96-recipe curated Vietnamese food database
FOOD_DB_PATH=ingredient_task/data_book.json

# Maximum number of recipes to retrieve for LLM context
RAG_TOP_K=5

# Optional Database URL (if syncing with backend MySQL)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/nckh

# ==============================================================================
# LLM PROVIDER CONFIGURATION
# ==============================================================================
# Options: gemini | openai | qwen | ollama
LLM_PROVIDER=gemini

# Google Gemini Configuration (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Qwen Modal Cloud Configuration (Optional)
QWEN_API_URL=https://YOUR_WORKSPACE--nckh-cooking-chat-chat.modal.run
QWEN_MODEL=nckh-qwen3-4b-lora
QWEN_REQUEST_TIMEOUT=180

# Ollama Local Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5

# ==============================================================================
# MODAL SERVERLESS DEPLOYMENT CONFIGURATION
# ==============================================================================
# GPU Type on Modal: T4 | A10G | None (for CPU)
MODAL_GPU=T4
