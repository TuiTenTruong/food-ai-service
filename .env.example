# ==============================================================================
# FOOD AI SERVICE - CẤU HÌNH HỆ THỐNG TOÀN DIỆN (LOCAL & MODAL CLOUD GPU)
# ==============================================================================

# Cổng dịch vụ chạy cục bộ
PORT=8000
APP_ENV=production

# ==============================================================================
# 1. CẤU HÌNH MÔ HÌNH NHẬN DẠNG NGUYÊN LIỆU (DETECTOR)
# ==============================================================================
# Chọn mô hình hoạt động: yolo26 | rtdetr | rfdetr
# Mặc định dùng mô hình YOLO26 38-class bạn đã train
INGREDIENT_MODEL=yolo26

# Đường dẫn file trọng số mô hình
YOLO26_MODEL_PATH=models_weights/yolo_best.pt
RTDETR_MODEL_PATH=models_weights/rtdetr_best.pt
RFDETR_MODEL_PATH=models_weights/rfdetr_best.pth

# Ngưỡng tin cậy nhận diện (0.0 - 1.0)
DETECTION_CONFIDENCE=0.25

# ==============================================================================
# 2. CƠ SỞ DỮ LIỆU & RAG ENGINE (96 CÔNG THỨC MÓN ĂN VIỆT NAM)
# ==============================================================================
# Kết nối MySQL (khi chạy local với nckh (2).sql)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/nckh

# File dữ liệu dự phòng chuẩn (tự động dùng khi chạy trên Modal Cloud GPU)
FOOD_DB_PATH=rag/data_book.json

# Số lượng công thức gợi ý tối đa
RAG_TOP_K=5

# ==============================================================================
# 3. CẤU HÌNH NHÀ CUNG CẤP LLM (CHỌN 1 TRONG 4 PROVIDERS)
# ==============================================================================
# Options: huggingface | gemini | ollama | openai
LLM_PROVIDER=huggingface

# --- [A] HUGGING FACE QWEN 2.5 (KHUYẾN NGHỊ - MIỄN PHÍ, MÃ NGUỒN MỞ) ---
# Đăng ký token miễn phí tại: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/v1/

# --- [B] GOOGLE GEMINI (RẤT NHANH, ĐÁP ỨNG TIẾNG VIỆT TỐT) ---
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- [C] OLLAMA (CHẠY HOÀN TOÀN OFFLINE TRÊN MÁY CỤC BỘ) ---
# Cài đặt Ollama từ https://ollama.com và chạy `ollama pull qwen2.5`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5
OLLAMA_RAG_MODEL=gemma2

# --- [D] OPENAI (GPT-4o Mini) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# 4. CẤU HÌNH TRIỂN KHAI MODAL CLOUD GPU SERVERLESS
# ==============================================================================
# Tên ứng dụng trên Modal dashboard
MODAL_APP_NAME=food-ai-service

# Loại GPU trên Modal: T4 (tiết kiệm, khuyến nghị) | A10G (mạnh) | None (chạy CPU)
MODAL_GPU=T4

# Thời gian chờ tắt container khi không có request (giây) -> 300s = 5 phút tự động về 0$
MODAL_SCALEDOWN_WINDOW=300
MODAL_TIMEOUT=600
